DB_HOST=localhost
DB_PORT=3306
DB_NAME=saludtotal
DB_USER=root
DB_PASS=

# Configuración de la Aplicación
APP_NAME=SaludTotal
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Rutas del Sistema
BASE_PATH=
PUBLIC_PATH=/public

# Configuración SOAP
SOAP_WSDL_URL=http://saludtotal-soap.test/public/wsdl/pacientes.wsdl
SOAP_SERVER_URL=http://saludtotal-soap.test/public/server/index.php
SOAP_CACHE=WSDL_CACHE_NONE

# Logs
LOG_ENABLED=true
LOG_PATH=storage/logs