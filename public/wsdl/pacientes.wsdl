<?xml version="1.0" encoding="UTF-8"?>
<definitions name="PacientesService"
    targetNamespace="http://saludtotal.com/soap/pacientes"
    xmlns:tns="http://saludtotal.com/soap/pacientes"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns="http://schemas.xmlsoap.org/wsdl/">

    <!-- Tipos de Datos -->
    <types>
        <xsd:schema targetNamespace="http://saludtotal.com/soap/pacientes">
            
            <!-- Tipo Paciente -->
            <xsd:complexType name="Paciente">
                <xsd:sequence>
                    <xsd:element name="id" type="xsd:int" minOccurs="0"/>
                    <xsd:element name="cedula" type="xsd:string"/>
                    <xsd:element name="nombres" type="xsd:string"/>
                    <xsd:element name="apellidos" type="xsd:string"/>
                    <xsd:element name="telefono" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="fecha_nacimiento" type="xsd:string"/>
                    <xsd:element name="direccion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="email" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="genero" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="estado" type="xsd:string" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>

            <!-- Tipo Respuesta -->
            <xsd:complexType name="Respuesta">
                <xsd:sequence>
                    <xsd:element name="exito" type="xsd:boolean"/>
                    <xsd:element name="mensaje" type="xsd:string"/>
                    <xsd:element name="datos" type="xsd:anyType" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>

            <!-- Array de Pacientes -->
            <xsd:complexType name="ArrayDePacientes">
                <xsd:sequence>
                    <xsd:element name="paciente" type="tns:Paciente" minOccurs="0" maxOccurs="unbounded"/>
                </xsd:sequence>
            </xsd:complexType>

        </xsd:schema>
    </types>

    <!-- Mensajes para crearPaciente -->
    <message name="crearPacienteRequest">
        <part name="datos" type="tns:Paciente"/>
    </message>
    <message name="crearPacienteResponse">
        <part name="return" type="tns:Respuesta"/>
    </message>

    <!-- Mensajes para buscarPaciente -->
    <message name="buscarPacienteRequest">
        <part name="cedula" type="xsd:string"/>
    </message>
    <message name="buscarPacienteResponse">
        <part name="return" type="tns:Respuesta"/>
    </message>

    <!-- Mensajes para listarPacientes -->
    <message name="listarPacientesRequest">
    </message>
    <message name="listarPacientesResponse">
        <part name="return" type="tns:Respuesta"/>
    </message>

    <!-- Mensajes para actualizarPaciente -->
    <message name="actualizarPacienteRequest">
        <part name="datos" type="tns:Paciente"/>
    </message>
    <message name="actualizarPacienteResponse">
        <part name="return" type="tns:Respuesta"/>
    </message>

    <!-- Mensajes para eliminarPaciente -->
    <message name="eliminarPacienteRequest">
        <part name="cedula" type="xsd:string"/>
    </message>
    <message name="eliminarPacienteResponse">
        <part name="return" type="tns:Respuesta"/>
    </message>

    <!-- Port Type -->
    <portType name="PacientesPortType">
        
        <operation name="crearPaciente">
            <documentation>RF-01: Crear un nuevo paciente</documentation>
            <input message="tns:crearPacienteRequest"/>
            <output message="tns:crearPacienteResponse"/>
        </operation>

        <operation name="buscarPaciente">
            <documentation>RF-02: Buscar paciente por cédula</documentation>
            <input message="tns:buscarPacienteRequest"/>
            <output message="tns:buscarPacienteResponse"/>
        </operation>

        <operation name="listarPacientes">
            <documentation>RF-03: Listar todos los pacientes</documentation>
            <input message="tns:listarPacientesRequest"/>
            <output message="tns:listarPacientesResponse"/>
        </operation>

        <operation name="actualizarPaciente">
            <documentation>RF-04: Actualizar datos de un paciente</documentation>
            <input message="tns:actualizarPacienteRequest"/>
            <output message="tns:actualizarPacienteResponse"/>
        </operation>

        <operation name="eliminarPaciente">
            <documentation>RF-05: Eliminar un paciente</documentation>
            <input message="tns:eliminarPacienteRequest"/>
            <output message="tns:eliminarPacienteResponse"/>
        </operation>

    </portType>

    <!-- Binding -->
    <binding name="PacientesBinding" type="tns:PacientesPortType">
        <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
        
        <operation name="crearPaciente">
            <soap:operation soapAction="crearPaciente"/>
            <input>
                <soap:body use="encoded" namespace="http://saludtotal.com/soap/pacientes" 
                          encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </input>
            <output>
                <soap:body use="encoded" namespace="http://saludtotal.com/soap/pacientes" 
                          encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </output>
        </operation>

        <operation name="buscarPaciente">
            <soap:operation soapAction="buscarPaciente"/>
            <input>
                <soap:body use="encoded" namespace="http://saludtotal.com/soap/pacientes" 
                          encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </input>
            <output>
                <soap:body use="encoded" namespace="http://saludtotal.com/soap/pacientes" 
                          encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </output>
        </operation>

        <operation name="listarPacientes">
            <soap:operation soapAction="listarPacientes"/>
            <input>
                <soap:body use="encoded" namespace="http://saludtotal.com/soap/pacientes" 
                          encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </input>
            <output>
                <soap:body use="encoded" namespace="http://saludtotal.com/soap/pacientes" 
                          encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </output>
        </operation>

        <operation name="actualizarPaciente">
            <soap:operation soapAction="actualizarPaciente"/>
            <input>
                <soap:body use="encoded" namespace="http://saludtotal.com/soap/pacientes" 
                          encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </input>
            <output>
                <soap:body use="encoded" namespace="http://saludtotal.com/soap/pacientes" 
                          encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </output>
        </operation>

        <operation name="eliminarPaciente">
            <soap:operation soapAction="eliminarPaciente"/>
            <input>
                <soap:body use="encoded" namespace="http://saludtotal.com/soap/pacientes" 
                          encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </input>
            <output>
                <soap:body use="encoded" namespace="http://saludtotal.com/soap/pacientes" 
                          encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </output>
        </operation>

    </binding>

    <!-- Service -->
    <service name="PacientesService">
        <documentation>Servicio SOAP para gestión de pacientes - Clínica SaludTotal</documentation>
        <port name="PacientesPort" binding="tns:PacientesBinding">
            <soap:address location="http://localhost/public/server/index.php"/>
        </port>
    </service>

</definitions>