<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Gateway SOAP (cliente) - Redirigir a client/routes.php
    RewriteRule ^soap/pacientes/?$ client/routes.php [L,QSA]
    RewriteRule ^soap/pacientes/(.+)$ client/routes.php [L,QSA]
    
    # Permitir acceso directo al servidor SOAP
    RewriteRule ^server/index\.php$ - [L]
    
    # Permitir acceso directo al WSDL
    RewriteRule ^wsdl/pacientes\.wsdl$ - [L]
    
    # Redirigir todo lo demás a index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

Options -Indexes
AddDefaultCharset UTF-8
