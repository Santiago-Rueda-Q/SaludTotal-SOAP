# .htaccess - Raíz del Proyecto
# Redirige todo al directorio public

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Si la petición no es para el directorio public, redirigir
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L,QSA]
    
    # Si es el índice raíz, redirigir a public
    RewriteRule ^$ public/ [L]
</IfModule>

# Prevenir acceso a directorios sensibles
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|config|storage|vendor)/ - [F,L]
</IfModule>

# Seguridad: Prevenir acceso a archivos sensibles
<FilesMatch "\.(env|json|xml|md|log|ini)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevenir listado de directorios
Options -Indexes

# Bloquear acceso a archivos ocultos
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>